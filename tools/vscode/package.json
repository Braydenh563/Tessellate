{
  "name": "tessellate-notes",
  "displayName": "Tessellate notes",
  "description": "Search your Tessellate notes, save a selection as a note, and give VS Code's chat your notebook's tools.",
  "version": "0.1.0",
  "publisher": "tessellate",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": { "vscode": "^1.101.0" },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      { "command": "tessellate.searchNotes", "title": "Search notes", "category": "Tessellate" },
      { "command": "tessellate.saveSelection", "title": "Save selection as a note", "category": "Tessellate" },
      { "command": "tessellate.setToken", "title": "Set tool server token", "category": "Tessellate" }
    ],
    "menus": {
      "editor/context": [
        { "command": "tessellate.saveSelection", "when": "editorHasSelection", "group": "9_tessellate" }
      ]
    },
    "configuration": {
      "title": "Tessellate",
      "properties": {
        "tessellate.url": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Where the app runs on this computer."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      { "id": "tessellate.notes", "label": "Tessellate notes" }
    ]
  }
}
